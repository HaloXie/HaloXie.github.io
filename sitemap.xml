---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% capture language_prefix %}{% if site.active_lang != site.default_lang %}/{{ site.active_lang }}{% endif %}{% endcapture %}
  {% assign collections = site.collections | where_exp: 'collection', 'collection.output != false' %}
  {% for collection in collections %}
    {% assign docs = collection.docs | where_exp: 'doc', 'doc.sitemap != false' %}
    {% for doc in docs %}
      {% capture localized_url %}{{ site.url }}{{ site.baseurl }}{{ language_prefix }}{{ doc.url | replace: '/index.html', '/' }}{% endcapture %}
      <url>
        <loc>{{ localized_url | xml_escape }}</loc>
        {% if doc.last_modified_at or doc.date %}<lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>{% endif %}
      </url>
    {% endfor %}
  {% endfor %}
  {% assign pages = site.html_pages | where_exp: 'item', 'item.sitemap != false' | where_exp: 'item', 'item.url != "/404.html"' %}
  {% for item in pages %}
    {% capture localized_url %}{{ site.url }}{{ site.baseurl }}{{ language_prefix }}{{ item.url | replace: '/index.html', '/' }}{% endcapture %}
    <url>
      <loc>{{ localized_url | xml_escape }}</loc>
      {% if item.last_modified_at %}<lastmod>{{ item.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
    </url>
  {% endfor %}
</urlset>
